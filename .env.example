# ---- Database: Neon POOLED connection string ----
DATABASE_URI=

# ---- Payload: generate with `openssl rand -hex 32` ----
PAYLOAD_SECRET=

# ---- Public site URL, no trailing slash ----
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ---- Cloudflare R2 (S3-compatible) ----
# Leave blank locally: uploads fall back to disk automatically.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_ENDPOINT=
NEXT_PUBLIC_S3_PUBLIC_URL=

# ---- Email (Resend) — wired in a later stage ----
RESEND_API_KEY=
EMAIL_FROM=
INQUIRY_NOTIFY_TO=

# ---- Spam protection (Cloudflare Turnstile) — later stage ----
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Optional: supplied by the marketing agency ----
NEXT_PUBLIC_GTM_ID=
